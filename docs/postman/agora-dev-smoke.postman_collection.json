{
  "info": {
    "name": "Agora Dev Smoke Test",
    "_postman_id": "9a91d918-6c46-45ed-b0ce-0fb4a61b9d1f",
    "description": "Smoke collection for the latest dev branch. Seed password: password123!. Tokens returned by the API already include the Bearer prefix.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080"
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "buyerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "buyerRefreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Auth",
      "item": [
        {
          "name": "Login - Seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller@test.com\",\n  \"password\": \"password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('seller login success', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('sellerToken', json.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Buyer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@test.com\",\n  \"password\": \"password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('buyer login success', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('buyerToken', json.data.accessToken);",
                  "pm.collectionVariables.set('buyerRefreshToken', json.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Root Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('admin login success', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Public Smoke",
      "item": [
        {
          "name": "Region List",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/regions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('regions return 5 seed rows', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.length).to.eql(5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Product List",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?page=0&size=3"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('product list returns requested page size', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.length).to.eql(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Product Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('product detail returns product 1', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.id).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Admin Smoke",
      "item": [
        {
          "name": "Admin User List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users?page=0&size=2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('admin users are paged', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.content.length).to.eql(2);",
                  "  pm.expect(data.totalElements).to.eql(5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin Product List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/products?reportedOnly=false&page=0&size=2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('admin products are paged', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.content.length).to.eql(2);",
                  "  pm.expect(data.totalElements).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin Reported Products Page",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/products?reportedOnly=true&page=0&size=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('reported products respect page size', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.content.length).to.eql(1);",
                  "  pm.expect(data.size).to.eql(1);",
                  "  pm.expect(data.totalElements).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin Product Reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/reports/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('product reports endpoint responds', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
